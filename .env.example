# --- Obligatoire ---------------------------------------------------------
# Base MongoDB (Atlas, Dokploy, autre). Le nom de la base peut figurer dans l'URI
# (…/manoir?…) ou dans MONGODB_DB. Tout y est stocké : textes, photos (GridFS),
# comptes, demandes, calendrier.
#
# Si le DNS du VPS ne résout pas les URI « mongodb+srv:// » (querySrv ESERVFAIL / ETIMEOUT),
# utilisez la forme standard « mongodb:// » avec la liste des serveurs du cluster, par ex. :
# mongodb://utilisateur:motdepasse@hote-00:27017,hote-01:27017,hote-02:27017/manoir?ssl=true&replicaSet=atlas-xxxx-shard-0&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster.exemple.mongodb.net/manoir?retryWrites=true&w=majority
MONGODB_DB=
# Facultatif : serveurs DNS utilisés par Node pour les requêtes SRV (si le VPS les autorise).
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Adresse publique du site (liens des e-mails, sitemap.xml, hreflang).
PUBLIC_URL=https://www.manoir-champagne.teovillet.fr

# Secret de signature des sessions admin. Générer avec : openssl rand -hex 32
SESSION_SECRET=

# Premier compte administrateur (créé au premier démarrage uniquement,
# quand la base ne contient encore aucun compte). Les suivants se créent
# depuis l'admin, menu « Utilisateurs ».
ADMIN_EMAIL=maryline@manoirdelachampagne.fr
ADMIN_PASSWORD=
ADMIN_NAME=Maryline Courteille

# --- Réseau ----------------------------------------------------------------
# Nombre de proxys devant l'app (Traefik = 1) : IP réelle des visiteurs, anti-abus.
TRUST_PROXY=1
# Mettre false uniquement si le site est servi en HTTP simple (tests).
COOKIE_SECURE=true

# --- Calendriers externes ----------------------------------------------------
# Fréquence de synchronisation des liens iCal (Abritel, Airbnb…) saisis dans l'admin.
ICAL_SYNC_MINUTES=30

# --- E-mail (optionnel mais recommandé) --------------------------------------
# Active : notification des demandes aux propriétaires (NOTIFY_EMAIL), accusé de
# réception au visiteur dans sa langue, « mot de passe oublié » et invitations.
# Envoi via Resend (https://resend.com) : créer une clé API et vérifier le domaine
# d'expédition (enregistrements DNS fournis par Resend).
RESEND_API_KEY=
# Expéditeur, sur le domaine vérifié dans Resend.
MAIL_FROM=Manoir de la Champagne <contact@manoirdelachampagne.fr>
# Destinataire des notifications de nouvelles demandes.
NOTIFY_EMAIL=

# --- Sauvegarde par e-mail (optionnel, nécessite RESEND_API_KEY) ---------------
# Chaque nuit, la base (hors photos) part en pièce jointe .json.gz à cette adresse ;
# le lundi, les photos suivent dans des e-mails séparés (20 Mo max chacun).
# Astuce Gmail : une adresse « +étiquette » se trie toute seule (voir README › Sauvegardes).
BACKUP_DB_MAIL=
# Heure (Paris) à partir de laquelle la sauvegarde du jour part.
# BACKUP_HOUR=3
# Nom dans l'objet « [backup_<nom>] … » (par défaut : début du domaine de PUBLIC_URL).
# BACKUP_NAME=manoir-champagne
