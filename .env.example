# --- Obligatoire ---------------------------------------------------------
# Secret de signature des sessions admin. Générer avec : openssl rand -hex 32
SESSION_SECRET=

# Premier compte administrateur (créé au premier démarrage uniquement).
ADMIN_EMAIL=maryline@manoirdelachampagne.fr
ADMIN_PASSWORD=
ADMIN_NAME=Maryline Courteille

# --- Réseau ----------------------------------------------------------------
# Port local sur lequel le reverse proxy joindra le conteneur.
HOST_PORT=3000
# Nombre de proxys devant l'app (pour l'IP réelle des visiteurs / rate limit).
TRUST_PROXY=1
# Mettre false uniquement si le site est servi en HTTP simple (tests).
COOKIE_SECURE=true

# --- E-mail (optionnel) ------------------------------------------------------
# Si renseigné, chaque demande de réservation est envoyée à NOTIFY_EMAIL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
